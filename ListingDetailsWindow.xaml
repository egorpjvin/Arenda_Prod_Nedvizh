<Window x:Class="Prodazha_Arenda_Nedvizhki.ListingDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробная информация" Height="600" Width="850"
        WindowStartupLocation="CenterScreen" Background="#F0F0F0">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E0E0E0" CornerRadius="8" Margin="0,0,20,0">
            <Grid>
                <TextBlock Text="Нет фото" Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=BigImage, Path=Source}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Image x:Name="BigImage" Stretch="UniformToFill"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="PriceText" FontSize="28" FontWeight="Bold" Foreground="#27AE60" Margin="0,0,0,15"/>

            <TextBlock x:Name="TypeText" FontSize="15" Margin="0,3"/>
            <TextBlock x:Name="CityText" FontSize="15" Margin="0,3"/>
            <TextBlock x:Name="AddressText" FontSize="15" Margin="0,3"/>
            <TextBlock x:Name="RoomsText" FontSize="15" Margin="0,3"/>
            <TextBlock x:Name="AreaText" FontSize="15" Margin="0,3"/>
            <TextBlock x:Name="FloorText" FontSize="15" Margin="0,3"/>
            <TextBlock x:Name="YearText" FontSize="15" Margin="0,3"/>

            <Separator Margin="0,10"/>

            <TextBlock Text="Описание:" FontSize="16" FontWeight="Bold" Margin="0,5"/>
            <TextBlock x:Name="DescriptionText" FontSize="14" TextWrapping="Wrap" Foreground="#333"/>
        </StackPanel>
    </Grid>
</Window>
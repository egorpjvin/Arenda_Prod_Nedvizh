<Window x:Class="Prodazha_Arenda_Nedvizhki.AgentMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рабочее место — Агент" Height="800" Width="1200" WindowStartupLocation="CenterScreen" Background="#F0F0F0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#27AE60" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Рабочее место агента" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="UserInfoText" FontSize="12" Foreground="White" Opacity="0.9" Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Добавить объявление" Click="BtnAddListing_Click" Background="Transparent" Foreground="White" Margin="5" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Заявки" Click="BtnRequests_Click" Background="Transparent" Foreground="White" Margin="5" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Готовые к сделке" Click="ShowReadyDeals_Click" Background="Transparent" Foreground="White" Padding="10,5" Margin="5" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnShowAll" Content="Показать все объявления" Click="ShowAll_Click" Background="#1E8449" Foreground="White" Padding="10,5" Margin="5" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Visibility="Collapsed"/>
                    <Button Content="Все сделки" Click="BtnDeals_Click" Background="Transparent" Foreground="White" Margin="5" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Обновить" Click="BtnRefresh_Click" Background="Transparent" Foreground="White" Margin="5" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
                    <Button Content="Выйти" Click="LogoutButton_Click" Background="#95A5A6" Foreground="White" Padding="10,5" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Поиск -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Padding="8" ToolTip="Ключевое слово"/>
                <ComboBox x:Name="TypeBox" Grid.Column="1" Width="120" Margin="8,0,0,0"/>
                <ComboBox x:Name="DealTypeBox" Grid.Column="2" Width="120" Margin="8,0,0,0"/>
                <TextBox x:Name="CityBox" Grid.Column="3" Width="120" Margin="8,0,0,0" Padding="8" ToolTip="Город"/>
                <Button Grid.Column="4" Content="Найти" Click="FindButton_Click" Background="#27AE60" Foreground="White" Padding="15,8" Margin="8,0,0,0" BorderThickness="0"/>
                <Button Grid.Column="5" Content="Сбросить" Click="ResetButton_Click" Background="#95A5A6" Foreground="White" Padding="15,8" Margin="8,0,0,0" BorderThickness="0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,15,20,5">
            <TextBlock x:Name="ListHeaderText" Text="Все объявления в системе" FontSize="16" FontWeight="SemiBold" Foreground="#000"/>
            <TextBlock x:Name="CountText" Text="Найдено: 0" FontSize="13" Foreground="#555" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Список объявлений -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="ListingsList" Background="Transparent" BorderThickness="0" Margin="20,0,20,15">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#27AE60"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10">
                            <Grid Height="150">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#ECECEC" CornerRadius="4">
                                    <Grid>
                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="20,10">
                                    <TextBlock Text="{Binding Zagolovok}" FontSize="18" FontWeight="Bold" Foreground="#000" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="14" Foreground="#555" Margin="0,5,0,0">
                                        <Run Text="{Binding Gorod}"/><Run Text=", "/><Run Text="{Binding Adres}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="14" Foreground="#333" Margin="0,10,0,0">
                                        <Run Text="Комнат: "/><Run Text="{Binding Komnat}" FontWeight="Bold"/>
                                        <Run Text=" | Площадь: "/><Run Text="{Binding Ploshchad, StringFormat=N2}" FontWeight="Bold"/><Run Text=" м²"/>
                                    </TextBlock>

                                    <!-- Плашка "Готов к сделке" -->
                                    <Border Background="#E8F8F5" BorderBrush="#27AE60" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReadyClientName}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ReadyClientName}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="14" Foreground="#27AE60" FontWeight="Bold">
                                            <Run Text="Клиент готов: "/><Run Text="{Binding ReadyClientName}"/>
                                        </TextBlock>
                                    </Border>
                                    <Button Content="Подробнее..." Click="DetailsButton_Click" Tag="{Binding}" Background="Transparent" Foreground="#27AE60" BorderThickness="0" HorizontalAlignment="Left" Margin="0,5,0,0" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tsena, StringFormat={}{0:N0} ₽}" FontSize="20" FontWeight="Bold" Foreground="#000" HorizontalAlignment="Right"/>
                                    <Button Content="Оформить сделку" Click="DealButton_Click" Tag="{Binding}" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="10,8" Margin="0,5,0,0" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
    </Grid>
</Window>
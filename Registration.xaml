<Window x:Class="Prodazha_Arenda_Nedvizhki.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="793" Width="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Background="#F0F0F0" Margin="0,0,0,-140">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="30,10,30,100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Создание профиля" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#2C3E50"/>

            <StackPanel Grid.Row="1" Margin="0,10">
                <TextBlock Text="Фамилия" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="5,0,0,5"/>
                <TextBox x:Name="SurnameTextBox" FontSize="14" Padding="10" BorderBrush="#CCC" BorderThickness="1" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,10">
                <TextBlock Text="Имя" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="5,0,0,5"/>
                <TextBox x:Name="NameTextBox" FontSize="14" Padding="10" BorderBrush="#CCC" BorderThickness="1" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,10">
                <TextBlock Text="Отчество" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="5,0,0,5"/>
                <TextBox x:Name="PatronymicTextBox" FontSize="14" Padding="10" BorderBrush="#CCC" BorderThickness="1" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,10">
                <TextBlock Text="Телефон" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="5,0,0,5"/>
                <TextBox x:Name="TelephoneTextBox" FontSize="14" Padding="10" BorderBrush="#CCC" BorderThickness="1" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Margin="0,10">
                <TextBlock Text="Дата рождения" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="5,0,0,5"/>
                <DatePicker x:Name="BirthdayTextBox" FontSize="14" Padding="10" BorderBrush="#CCC" BorderThickness="1" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Row="6" Margin="0,10">
                <TextBlock Text="Логин" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="5,0,0,5"/>
                <TextBox x:Name="LoginTextBox" FontSize="14" Padding="10" BorderBrush="#CCC" BorderThickness="1" Background="White"/>
            </StackPanel>
            <StackPanel Grid.Row="7" Margin="0,10">
                <TextBlock Text="Роль пользователя" FontSize="14" FontWeight="SemiBold" Foreground="#555" Margin="5,0,0,5"/>
                <ComboBox x:Name="RoleBox" FontSize="14" Padding="10" BorderBrush="#CCC" BorderThickness="1" Background="White" SelectedIndex="0">
                    <ComboBoxItem>Клиент</ComboBoxItem>
                    <ComboBoxItem>Агент</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <Button Grid.Row="8" Content="Зарегистрироваться" Click="RegisterButton_Click" Background="#27AE60" Foreground="White" FontSize="16" FontWeight="Bold" Padding="15" Margin="0,20,0,50" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
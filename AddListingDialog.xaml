<Window x:Class="Prodazha_Arenda_Nedvizhki.AddListingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Объявление" Height="889" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="#F0F0F0">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" Text="Новое объявление" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#2C3E50"/>

        <StackPanel Grid.Row="1" Margin="0,3" x:Name="OwnerPanel" Visibility="Collapsed">
            <TextBlock Text="Владелец (Продавец) *" FontWeight="SemiBold" Foreground="#555"/>
            <ComboBox x:Name="OwnerBox" Padding="8" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,3">
            <TextBlock Text="Тип объекта" FontWeight="SemiBold" Foreground="#555"/>
            <ComboBox x:Name="ObjectTypeBox" Padding="8" FontSize="13" SelectedIndex="0">
                <ComboBoxItem>Квартира</ComboBoxItem>
                <ComboBoxItem>Дом</ComboBoxItem>
                <ComboBoxItem>Коммерческая</ComboBoxItem>
                <ComboBoxItem>Участок</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,3">
            <TextBlock Text="Заголовок *" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox x:Name="TitleBox" Padding="8" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,3">
            <TextBlock Text="Адрес *" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox x:Name="AddressBox" Padding="8" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,3">
            <TextBlock Text="Город *" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox x:Name="CityBox" Padding="8" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,3">
            <TextBlock Text="Район" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox x:Name="DistrictBox" Padding="8" FontSize="13"/>
        </StackPanel>

        <Grid Grid.Row="7" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Площадь, м² *" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="AreaBox" Padding="8" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Комнат *" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="RoomsBox" Padding="8" FontSize="13"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="8" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Этаж" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="FloorBox" Padding="8" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Этажей в доме" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="TotalFloorsBox" Padding="8" FontSize="13"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="9" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Год постройки" FontWeight="SemiBold" Foreground="#555"/>
                <TextBox x:Name="YearBox" Padding="8" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Тип объявления" FontWeight="SemiBold" Foreground="#555"/>
                <ComboBox x:Name="DealTypeBox" Padding="8" FontSize="13" SelectedIndex="0">
                    <ComboBoxItem>Продажа</ComboBoxItem>
                    <ComboBoxItem>Аренда</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="10" Margin="0,3">
            <TextBlock Text="Цена, ₽ *" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox x:Name="PriceBox" Padding="8" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="11" Margin="0,3">
            <TextBlock Text="Описание" FontWeight="SemiBold" Foreground="#555"/>
            <TextBox x:Name="DescriptionBox" Padding="8" FontSize="13" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Row="12" Margin="0,5">
            <TextBlock Text="Фотография" FontWeight="SemiBold" Foreground="#555"/>
            <StackPanel Orientation="Horizontal">
                <Button Content="Выбрать фото" Click="SelectPhoto_Click" Background="#95A5A6" Foreground="White" BorderThickness="0" Padding="10,5" Cursor="Hand"/>
                <Image x:Name="PreviewImage" Width="80" Height="60" Margin="10,0,0,0" Stretch="UniformToFill"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="140" Padding="10" Margin="4" Background="#27AE60" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="140" Padding="10" Margin="4" Background="#95A5A6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
<Window x:Class="Prodazha_Arenda_Nedvizhki.AdminMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель администратора" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#F0F0F0">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E8449"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#27AE60" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Панель администратора" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="UserInfoText" FontSize="12" Foreground="White" Opacity="0.9" Margin="0,2,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Content="Резервное копирование БД" Click="BtnBackup_Click" Style="{StaticResource HeaderButtonStyle}" Background="#1E8449" Margin="0,0,10,0"/>
                    <Button Content="Обновить" Click="BtnRefresh_Click" Style="{StaticResource HeaderButtonStyle}"/>
                    <Button Content="Выйти" Click="LogoutButton_Click" Style="{StaticResource HeaderButtonStyle}" Background="#95A5A6"/>
                </WrapPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Управление объявлениями">
                <Grid Margin="10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ListingsList" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10">
                                        <Grid Height="150">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#ECECEC" CornerRadius="4">
                                                <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="20,10">
                                                <TextBlock Text="{Binding Zagolovok}" FontSize="18" FontWeight="Bold" Foreground="#000" TextWrapping="Wrap"/>
                                                <TextBlock FontSize="14" Foreground="#555" Margin="0,5,0,0">
                                                    <Run Text="{Binding Gorod}"/><Run Text=", "/><Run Text="{Binding Adres}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="14" Foreground="#333" Margin="0,10,0,0">
                                                    <Run Text="Комнат: "/><Run Text="{Binding Komnat}" FontWeight="Bold"/>
                                                    <Run Text=" | Площадь: "/><Run Text="{Binding Ploshchad, StringFormat=N2}" FontWeight="Bold"/><Run Text=" м²"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Tsena, StringFormat={}{0:N0} ₽}" FontSize="20" FontWeight="Bold" Foreground="#000" HorizontalAlignment="Right"/>
                                                <Button Content="Удалить объявление" Click="DeleteListing_Click" Tag="{Binding}" Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="10,8" Margin="0,15,0,0" BorderThickness="0" Cursor="Hand"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Управление пользователями">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>
                    <DataGrid x:Name="UsersGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionChanged="UsersGrid_SelectionChanged" HeadersVisibility="Column" 
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding KOD_Polzovatelya}" Width="50"/>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="120"/>
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding Familiya}" Width="120"/>
                            <DataGridTextColumn Header="Имя" Binding="{Binding Imya}" Width="100"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Telefon}" Width="120"/>
                            <DataGridTextColumn Header="Роль" Binding="{Binding Rol}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Column="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6" Padding="15">
                        <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                            <TextBlock Text="Редактирование профиля" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>

                            <TextBlock Text="Логин" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBox x:Name="EditLogin" Margin="0,5,0,10" Padding="8"/>

                            <TextBlock Text="Фамилия" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBox x:Name="EditSurname" Margin="0,5,0,10" Padding="8"/>

                            <TextBlock Text="Имя" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBox x:Name="EditName" Margin="0,5,0,10" Padding="8"/>

                            <TextBlock Text="Телефон" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBox x:Name="EditPhone" Margin="0,5,0,10" Padding="8"/>

                            <TextBlock Text="Роль" FontWeight="SemiBold" Foreground="#555"/>
                            <ComboBox x:Name="EditRole" Margin="0,5,0,15" Padding="8">
                                <ComboBoxItem>Клиент</ComboBoxItem>
                                <ComboBoxItem>Агент</ComboBoxItem>
                                <ComboBoxItem>Администратор</ComboBoxItem>
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Сохранить" Click="SaveUser_Click" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Удалить" Click="DeleteUser_Click" Background="#95A5A6" Foreground="White" FontWeight="Bold" Padding="15,8" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#ECECEC" Padding="20,8">
            <TextBlock x:Name="StatusBarText" Text="Готово" FontSize="12" Foreground="#555"/>
        </Border>
    </Grid>
</Window>